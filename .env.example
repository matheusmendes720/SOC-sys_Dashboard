# Used by vite.config.ts (define-injected into the client bundle). The Gemini SDK
# is declared in package.json but is **not currently imported** anywhere in src/
# (verified by grep). The key wiring exists for future use.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# The URL where this applet is hosted. AI Studio injects this at runtime with
# the Cloud Run service URL. Used for self-referential links, OAuth callbacks,
# and API endpoints.
APP_URL="MY_APP_URL"

# Optional. Set to true to disable Vite HMR (used by AI Studio's agent-edit
# loop). Do not enable locally unless you know why.
# DISABLE_HMR=true
